{
  "name": "@remixcn/workspace",
  "private": true,
  "description": "shadcn components for Remix V3: accessible, dependency-free UI components, a shadcn-style registry, CLI and MCP server",
  "keywords": [
    "shadcn components for Remix V3",
    "shadcn",
    "shadcn-ui",
    "remix",
    "remix-v3",
    "registry",
    "ui-components",
    "accessibility",
    "design-system",
    "remixcn",
    "cli",
    "mcp"
  ],
  "homepage": "https://janhesters.github.io/remixcn/",
  "bugs": {
    "url": "https://github.com/janhesters/remixcn/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janhesters/remixcn.git"
  },
  "license": "MIT",
  "author": "Jan Hesters",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "imports": {
    "#remixcn/ui/*": "./registry/ui/*",
    "#remixcn/lib/*": "./registry/lib/*"
  },
  "scripts": {
    "check": "node scripts/check.ts",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/fixtures/consumer-app",
    "test": "remix test --type server",
    "test:browser": "remix test --type browser --playwrightConfig ./playwright.browser.config.ts",
    "test:e2e": "remix test --type e2e",
    "check:components": "node scripts/check-components.ts",
    "check:secrets": "node scripts/check-secrets.ts",
    "build": "bun run --filter remixcn build",
    "build:registry": "node scripts/build-registry.ts",
    "check:build": "node scripts/check-build.ts",
    "style-reference": "node --import remix/node-tsx test/fixtures/style-reference/server.tsx",
    "capture:style-reference": "node --import remix/node-tsx test/fixtures/style-reference/capture.ts",
    "button-examples": "node --import remix/node-tsx test/fixtures/button/server.tsx",
    "capture:button-examples": "node --import remix/node-tsx test/fixtures/button/capture.ts",
    "layout": "node --import remix/node-tsx test/fixtures/layout/server.tsx",
    "capture:layout": "node --import remix/node-tsx test/fixtures/layout/capture.ts",
    "code-block-examples": "node --import remix/node-tsx test/fixtures/code-block/server.tsx",
    "capture:code-block-examples": "node --import remix/node-tsx test/fixtures/code-block/capture.ts",
    "slider-examples": "node --import remix/node-tsx test/fixtures/slider/server.tsx",
    "capture:slider-examples": "node --import remix/node-tsx test/fixtures/slider/capture.ts",
    "display-examples": "node --import remix/node-tsx test/fixtures/display/server.tsx",
    "capture:display-examples": "node --import remix/node-tsx test/fixtures/display/capture.ts",
    "dialog-examples": "node --import remix/node-tsx test/fixtures/dialog/server.tsx",
    "capture:dialog-examples": "node --import remix/node-tsx test/fixtures/dialog/capture.ts",
    "message-scroller-examples": "node --import remix/node-tsx test/fixtures/message-scroller/server.tsx",
    "capture:message-scroller-examples": "node --import remix/node-tsx test/fixtures/message-scroller/capture.ts",
    "controls": "node --import remix/node-tsx test/fixtures/controls/server.tsx",
    "capture:controls": "node --import remix/node-tsx test/fixtures/controls/capture.ts",
    "carousel-examples": "node --import remix/node-tsx test/fixtures/carousel/server.tsx",
    "capture:carousel-examples": "node --import remix/node-tsx test/fixtures/carousel/capture.ts",
    "conversation-examples": "node --import remix/node-tsx test/fixtures/conversation/server.tsx"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "packageManager": "bun@1.4.2",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.4",
    "oxlint": "1.90.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "remix": "3.0.0",
    "shadcn": "4.23.0",
    "typescript": "7.0.2"
  }
}
